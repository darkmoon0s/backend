generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  ANALYST
  VIEWER
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum BillingPlan {
  FREE
  PRO
  PREMIUM
  AGENCY
  ENTERPRISE
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  TRACKED
}

enum PromptIntentCategory {
  HIGH_INTENT
  COMPARISON
  COMMERCIAL
  INFORMATIONAL
}

enum CitationSourceType {
  MEDIA
  ANALYST
  GOVERNMENT
  STANDARD
  VENDOR
  MARKETPLACE
  COMMUNITY
  ACADEMIC
  OTHER
}

enum CitationOpportunityStatus {
  OPEN
  IN_PROGRESS
  WON
  DISMISSED
}

enum GeoInsightType {
  THREAT
  VISIBILITY_OPPORTUNITY
  QUICK_WIN
  LOST_REVENUE
  BENCHMARK
  CONTENT_GAP
  ACTION_PLAN
  CITATION_OPPORTUNITY
}

enum GeoInsightStatus {
  OPEN
  ACTIONED
  DISMISSED
  INSUFFICIENT_DATA
}

enum ActionOutcomeStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  IGNORED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String?
  avatarUrl     String?
  isActive      Boolean   @default(true)
  platformRole  PlatformRole @default(USER)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   OrganizationMember[]
  supportTickets SupportTicket[]
  notifications Notification[]
  assignedTickets SupportTicket[] @relation("AssignedSupportTickets")
  auditLogs     AuditLog[] @relation("AuditActor")
  impersonationAuditLogs AuditLog[] @relation("AuditTargetUser")
  copilotInteractions GeoCopilotInteraction[]
  assignedGeoTasks GeoTask[] @relation("GeoTaskOwner")
  geoExecutionPackages GeoExecutionPackage[]
}

model Organization {
  id               String    @id @default(uuid())
  name             String
  slug             String    @unique
  billingPlan      BillingPlan @default(FREE)
  status           String    @default("ACTIVE")
  stripeCustomerId String?
  logoUrl          String?
  brandingColor    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  members          OrganizationMember[]
  brands           Brand[]
  prompts          Prompt[]
  jobs             Job[]
  reports          Report[]
  geoAudits        GeoAudit[]
  subscriptions    Subscription[]
  payments         Payment[]
  customLimits     CustomLimits?
  settings         OrganizationSettings?
  featureFlags     FeatureFlag[]
  supportTickets   SupportTicket[]
  notifications     Notification[]
  auditLogs        AuditLog[]
  couponRedemptions CouponRedemption[]
  agencyCopilotSummaries AgencyCopilotSummary[]
  autonomousRuns   AutonomousRun[]
  autonomousAlerts AutonomousAlert[]
  clientHealthScores ClientHealthScore[]
  geoOsStatusSnapshots GeoOsStatusSnapshot[]
  sroAnalyses      SroAnalysis[]
  geoExecutionAssets GeoExecutionAsset[]
  geoExecutionPackages GeoExecutionPackage[]
  cmsConnections   CmsConnection[]
  cmsPublications  CmsPublication[]
  geoOsInboxes     GeoOsInbox[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  role           Role         @default(VIEWER)
  organizationId String
  userId         String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Brand {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  websiteUrl     String?
  industry       String?
  country        String       @default("United States")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  competitors    Competitor[]
  competitorSuggestions CompetitorSuggestion[]
  analytics      AnalyticsSnapshot[]
  prompts        Prompt[]
  promptSuggestions PromptSuggestion[]
  reports        Report[]
  geoAudits      GeoAudit[]
  citationOpportunities CitationOpportunity[]
  geoScoreSnapshots GeoScoreSnapshot[]
  geoInsights    GeoInsight[]
  intelligenceSnapshots IntelligenceSnapshot[]
  intelligenceChanges IntelligenceChange[]
  recommendationOutcomes RecommendationOutcome[]
  entityAliases EntityAlias[]
  geoResearchRuns GeoResearchRun[]
  geoResearchItems GeoResearchItem[]
  marketCoverageSnapshots MarketCoverageSnapshot[]
  automatedAnalystSummaries AutomatedAnalystSummary[]
  copilotInteractions GeoCopilotInteraction[]
  geoActionPlans GeoActionPlan[]
  geoTasks GeoTask[]
  geoForecasts GeoForecast[]
  competitorWarRoomSnapshots CompetitorWarRoomSnapshot[]
  graphInfluenceSnapshots GraphInfluenceSnapshot[]
  commandCenterSnapshots CommandCenterSnapshot[]
  autonomousRuns AutonomousRun[]
  autonomousAlerts AutonomousAlert[]
  autonomousPrioritizationSnapshots AutonomousPrioritizationSnapshot[]
  clientHealthScores ClientHealthScore[]
  geoLearningOutcomes GeoLearningOutcome[]
  geoOsStatusSnapshots GeoOsStatusSnapshot[]
  sroAnalyses SroAnalysis[]
  competitorPageAnalyses CompetitorPageAnalysis[]
  geoExecutionAssets GeoExecutionAsset[]
  geoExecutionPackages GeoExecutionPackage[]
  cmsConnections CmsConnection[]
  cmsPublications CmsPublication[]
  roiImpactSnapshots RoiImpactSnapshot[]
  geoOsInboxes GeoOsInbox[]

  @@index([organizationId])
  @@index([organizationId, name])
}

model Competitor {
  id             String   @id @default(uuid())
  brandId        String
  name           String
  websiteUrl     String?
  createdAt      DateTime @default(now())

  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  suggestions    CompetitorSuggestion[]
  citationOpportunities CitationOpportunity[]
  pageAnalyses   CompetitorPageAnalysis[]

  @@index([brandId])
}

model CompetitorSuggestion {
  id                   String           @id @default(uuid())
  brandId              String
  name                 String
  websiteUrl           String?
  description          String?
  industry             String?
  country              String?
  confidenceScore      Float            @default(0)
  evidence             Json?
  sources              Json?
  dataSource           String           @default("AI_PROVIDER")
  status               SuggestionStatus @default(PENDING)
  approvedCompetitorId String?
  lastVerifiedAt       DateTime?
  discoveredAt         DateTime         @default(now())
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  brand                Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  approvedCompetitor   Competitor?      @relation(fields: [approvedCompetitorId], references: [id], onDelete: SetNull)

  @@unique([brandId, name])
  @@index([brandId, status])
  @@index([brandId, confidenceScore])
}

model Prompt {
  id             String   @id @default(uuid())
  organizationId String
  brandId        String
  queryText      String
  frequency      String   @default("daily")
  isActive       Boolean  @default(true)
  lastRunAt      DateTime?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand          Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  responses      AiResponse[]
  suggestions    PromptSuggestion[]
  citationOpportunities CitationOpportunity[]
  geoScoreSnapshots GeoScoreSnapshot[]

  @@index([organizationId])
  @@index([brandId])
  @@index([organizationId, isActive])
}

model PromptSuggestion {
  id                     String               @id @default(uuid())
  brandId                String
  queryText              String
  category               PromptIntentCategory @default(INFORMATIONAL)
  intentScore            Float                @default(0)
  opportunityScore       Float                @default(0)
  difficultyScore        Float                @default(0)
  expectedVisibilityGain Float                @default(0)
  confidenceScore        Float                @default(0)
  evidence               Json?
  sources                Json?
  dataSource             String               @default("AI_PROVIDER")
  sourceCompetitorIds    String[]             @default([])
  status                 SuggestionStatus     @default(PENDING)
  approvedPromptId       String?
  lastVerifiedAt         DateTime?
  discoveredAt           DateTime             @default(now())
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  brand                  Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  approvedPrompt         Prompt?              @relation(fields: [approvedPromptId], references: [id], onDelete: SetNull)

  @@unique([brandId, queryText])
  @@index([brandId, status])
  @@index([brandId, opportunityScore])
}

model AiEngine {
  id             String       @id @default(uuid())
  name           String       @unique
  version        String?
  createdAt      DateTime     @default(now())

  responses      AiResponse[]
  analytics      AnalyticsSnapshot[]
  geoScoreSnapshots GeoScoreSnapshot[]
}

model AiResponse {
  id                String   @id @default(uuid())
  promptId          String
  engineId          String
  rawContent        String
  structuredContent Json?
  status            String   @default("COMPLETED")
  error             String?
  capturedAt        DateTime @default(now())
  completedAt       DateTime?
  screenshotUrl     String?
  performance_ms    Int?     // Time taken to capture response

  prompt            Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  engine            AiEngine @relation(fields: [engineId], references: [id], onDelete: Cascade)
  mentions          Mention[]
  citations         Citation[]
  screenshots       Screenshot[]
  citationOpportunities CitationOpportunity[]

  @@index([promptId, capturedAt])
  @@index([engineId, capturedAt])
  @@index([status])
}

model Screenshot {
  id            String     @id @default(uuid())
  responseId    String
  url           String
  type          String     // 'full', 'snippet'
  createdAt     DateTime   @default(now())

  response      AiResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
}

model Mention {
  id             String     @id @default(uuid())
  responseId     String
  entityId       String
  entityType     String     // 'brand' or 'competitor'
  sentimentScore Float?     // -1.0 to 1.0
  contextSnippet String?
  position       Int?       // Position in response (1-indexed)
  isRecommended  Boolean    @default(false)
  createdAt      DateTime   @default(now())

  response       AiResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([entityType, entityId])
  @@index([responseId, entityType])
}

model Citation {
  id             String     @id @default(uuid())
  responseId     String
  url            String
  title          String?
  domain         String?
  authorityScore Float?     // 0.0 to 1.0
  createdAt      DateTime   @default(now())

  response       AiResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([domain])
}

model CitationSource {
  id                String             @id @default(uuid())
  domain            String             @unique
  name              String?
  url               String?
  sourceType        CitationSourceType @default(OTHER)
  authorityScore    Float              @default(0)
  industryRelevance Float              @default(0)
  geoRelevance      Float              @default(0)
  countryRelevance  Float              @default(0)
  evidence          Json?
  dataSource        String             @default("DISCOVERY")
  lastVerifiedAt    DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  opportunities     CitationOpportunity[]

  @@index([sourceType])
  @@index([authorityScore])
}

model CitationOpportunity {
  id                String                    @id @default(uuid())
  brandId           String
  citationSourceId  String
  competitorId      String?
  promptId          String?
  aiResponseId      String?
  opportunityScore  Float                     @default(0)
  competitorCitations Int                     @default(0)
  brandCitations    Int                       @default(0)
  missingForBrand   Boolean                   @default(true)
  evidence          Json?
  recommendedAction String?
  dataSource        String                    @default("PROMPT_TRACKING")
  confidenceScore   Float                     @default(0)
  status            CitationOpportunityStatus @default(OPEN)
  lastVerifiedAt    DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  brand             Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  citationSource    CitationSource            @relation(fields: [citationSourceId], references: [id], onDelete: Cascade)
  competitor        Competitor?               @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  prompt            Prompt?                   @relation(fields: [promptId], references: [id], onDelete: SetNull)
  aiResponse        AiResponse?               @relation(fields: [aiResponseId], references: [id], onDelete: SetNull)

  @@index([brandId, opportunityScore])
  @@index([brandId, status])
  @@index([citationSourceId])
}

model AnalyticsSnapshot {
  id             String    @id @default(uuid())
  brandId        String
  engineId       String
  snapshotDate   DateTime
  geoScore       Float?    // 0 to 100
  shareOfVoice   Float?    // Percentage
  avgSentiment   Float?    // -1 to 1
  mentionCount   Int       @default(0)
  citationCount  Int       @default(0)
  recommendations Recommendation[]
  createdAt      DateTime  @default(now())

  brand          Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  engine         AiEngine  @relation(fields: [engineId], references: [id], onDelete: Cascade)

  @@unique([brandId, engineId, snapshotDate])
  @@index([brandId, snapshotDate])
  @@index([engineId, snapshotDate])
}

model GeoScoreSnapshot {
  id                String    @id @default(uuid())
  brandId           String
  engineId          String?
  promptId          String?
  geoAuditId        String?
  snapshotDate      DateTime
  overallScore      Float     @default(0)
  schemaScore       Float     @default(0)
  faqScore          Float     @default(0)
  authorityScore    Float     @default(0)
  contentScore      Float     @default(0)
  citationScore     Float     @default(0)
  entityScore       Float     @default(0)
  breakdown         Json?
  evidence          Json?
  explanation       Json?
  dataSource        String    @default("GEO_SCORE_V2")
  confidenceScore   Float     @default(0)
  lastVerifiedAt    DateTime?
  createdAt         DateTime  @default(now())

  brand             Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  engine            AiEngine? @relation(fields: [engineId], references: [id], onDelete: SetNull)
  prompt            Prompt?   @relation(fields: [promptId], references: [id], onDelete: SetNull)
  geoAudit          GeoAudit? @relation(fields: [geoAuditId], references: [id], onDelete: SetNull)

  @@index([brandId, snapshotDate])
  @@index([engineId, snapshotDate])
  @@index([confidenceScore])
}

model GeoInsight {
  id                     String           @id @default(uuid())
  brandId                String
  type                   GeoInsightType
  title                  String
  summary                String
  priority               String           @default("medium")
  impactScore            Float            @default(0)
  difficultyScore        Float            @default(0)
  confidenceScore        Float            @default(0)
  expectedVisibilityGain Float?
  expectedScoreIncrease  Float?
  estimatedRevenueImpact Float?
  evidence               Json?
  actions                Json?
  dataSource             String           @default("GEO_INTELLIGENCE")
  status                 GeoInsightStatus @default(OPEN)
  lastVerifiedAt         DateTime?
  generatedAt            DateTime         @default(now())
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  brand                  Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, type])
  @@index([brandId, priority])
  @@index([brandId, confidenceScore])
}

model Recommendation {
  id             String    @id @default(uuid())
  snapshotId     String
  type           String    // 'strategic', 'content', 'citation'
  priority       String    @default("medium") // low, medium, high
  title          String
  content        String
  isActioned     Boolean   @default(false)
  createdAt      DateTime  @default(now())

  snapshot       AnalyticsSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([priority])
}

model Report {
  id             String       @id @default(uuid())
  organizationId String
  brandId        String?
  title          String
  type           String       @default("PDF")
  status         String       @default("GENERATED")
  periodStart    DateTime?
  periodEnd      DateTime?
  fileName       String?
  fileUrl        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand          Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([brandId, createdAt])
}

model GeoAudit {
  id                 String       @id @default(uuid())
  organizationId     String
  brandId            String?
  url                String
  status             String       @default("COMPLETED")
  geoScore           Float        @default(0)
  aeoScore           Float        @default(0)
  authorityScore     Float        @default(0)
  citationReadiness  Float        @default(0)
  schemaReadiness    Float        @default(0)
  faqCoverage        Float        @default(0)
  contentCoverage    Float        @default(0)
  targetKeywords     String[]     @default([])
  pageTitle          String?
  metaDescription    String?
  wordCount          Int          @default(0)
  checks             Json?
  recommendations    Json?
  error              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand              Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  geoScoreSnapshots  GeoScoreSnapshot[]

  @@index([organizationId, createdAt])
  @@index([brandId, createdAt])
  @@index([status])
}

model SroAnalysis {
  id                    String       @id @default(uuid())
  organizationId        String
  brandId               String
  url                   String
  targetPrompt          String
  industry              String?
  country               String?
  status                String       @default("COMPLETED")
  sroScore              Float        @default(0)
  geoScore              Float        @default(0)
  citationReadiness     Float        @default(0)
  entityReadiness       Float        @default(0)
  selectionProbability  Float        @default(0)
  confidenceScore       Float        @default(0)
  pageTitle             String?
  wordCount             Int          @default(0)
  checks                Json?
  evidence              Json?
  competitorComparison  Json?
  contentGaps           Json?
  improvementOpportunities Json?
  dataSource            String       @default("SRO_ENGINE_V1")
  error                 String?
  lastVerifiedAt        DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand                 Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  competitorAnalyses    CompetitorPageAnalysis[]

  @@index([organizationId, createdAt])
  @@index([brandId, createdAt])
  @@index([brandId, targetPrompt])
  @@index([status])
}

model CompetitorPageAnalysis {
  id                   String      @id @default(uuid())
  brandId              String
  competitorId         String?
  sroAnalysisId        String?
  competitorName       String
  url                  String?
  status               String      @default("COMPLETED")
  contentDepthScore    Float       @default(0)
  entityScore          Float       @default(0)
  schemaScore          Float       @default(0)
  faqScore             Float       @default(0)
  citationScore        Float       @default(0)
  authoritySignalScore Float       @default(0)
  overallScore         Float       @default(0)
  confidenceScore      Float       @default(0)
  pageTitle            String?
  wordCount            Int         @default(0)
  entities             Json?
  citations            Json?
  schemaTypes          Json?
  evidence             Json?
  dataSource           String      @default("COMPETITOR_PAGE_SCRAPER_V1")
  error                String?
  lastVerifiedAt       DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  brand                Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  competitor           Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  sroAnalysis          SroAnalysis? @relation(fields: [sroAnalysisId], references: [id], onDelete: SetNull)

  @@index([brandId, createdAt])
  @@index([competitorId, createdAt])
  @@index([sroAnalysisId])
}

model GeoExecutionAsset {
  id              String       @id @default(uuid())
  organizationId  String
  brandId         String
  type            String
  title           String
  status          String       @default("GENERATED")
  input           Json?
  output          Json?
  markdown        String?
  evidence        Json?
  confidenceScore Float        @default(0)
  revenueImpact   Float        @default(0)
  geoImpact       Float        @default(0)
  difficultyScore Float        @default(0)
  priorityScore   Float        @default(0)
  dataSource      String       @default("GEO_EXECUTION_ENGINE_V1")
  lastVerifiedAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand           Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([brandId, type, createdAt])
  @@index([brandId, priorityScore])
  @@index([status])
}

model GeoExecutionPackage {
  id              String       @id @default(uuid())
  organizationId  String
  brandId         String
  createdById     String?
  title           String
  status          String       @default("READY")
  assetIds        Json?
  contents        Json?
  markdown        String?
  exports         Json?
  evidence        Json?
  confidenceScore Float        @default(0)
  priorityScore   Float        @default(0)
  dataSource      String       @default("GEO_AUTOPILOT_PACKAGER")
  lastVerifiedAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand           Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  publications    CmsPublication[]

  @@index([organizationId, createdAt])
  @@index([brandId, status, createdAt])
  @@index([createdById])
}

model CmsConnection {
  id              String       @id @default(uuid())
  organizationId  String
  brandId         String?
  provider        String
  siteUrl         String
  status          String       @default("NEEDS_CREDENTIALS")
  credentialsRef  String?
  credentialsMeta Json?
  evidence        Json?
  confidenceScore Float        @default(0)
  lastVerifiedAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand           Brand?       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  publications    CmsPublication[]

  @@index([organizationId, provider])
  @@index([brandId, provider])
  @@index([status])
}

model CmsPublication {
  id              String       @id @default(uuid())
  organizationId  String
  brandId         String
  connectionId    String?
  packageId       String?
  assetId         String?
  provider        String
  contentType     String       @default("PAGE")
  title           String
  status          String       @default("DRAFT")
  remoteId        String?
  remoteUrl       String?
  requestPayload  Json?
  response        Json?
  evidence        Json?
  confidenceScore Float        @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand           Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  connection      CmsConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  package         GeoExecutionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([organizationId, provider, status])
  @@index([brandId, status])
  @@index([connectionId])
  @@index([packageId])
}

model IndustryBenchmark {
  id                String   @id @default(uuid())
  industry          String
  country           String
  sampleSize        Int      @default(0)
  avgGeoScore       Float    @default(0)
  avgCitationScore  Float    @default(0)
  avgVisibilityScore Float   @default(0)
  avgAuthorityScore Float    @default(0)
  percentiles       Json?
  sourceDescription String?
  confidenceScore   Float    @default(0)
  computedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([industry, country])
  @@index([computedAt])
}

model IntelligenceSnapshot {
  id              String   @id @default(uuid())
  brandId         String
  engine          String
  subjectType     String
  subjectId       String?
  metricKey       String
  metricValue     Float?
  payload         Json?
  evidence        Json?
  confidenceScore Float    @default(0)
  dataSource      String   @default("INTELLIGENCE_MEMORY")
  sourceHash      String
  capturedAt      DateTime @default(now())
  periodStart     DateTime?
  periodEnd       DateTime?
