model Plan {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  description      String?
  priceMonthly     Float    @default(0)
  priceAnnual      Float    @default(0)
  currency         String   @default("USD")
  brandsLimit      Int      @default(1)
  competitorsLimit Int      @default(3)
  usersLimit       Int      @default(1)
  promptsLimit     Int      @default(5)
  aiRequestsLimit  Int      @default(100)
  reportsLimit     Int      @default(1)
  whiteLabelAccess Boolean  @default(false)
  apiAccess         Boolean  @default(false)
  supportLevel      String   @default("Community")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions    Subscription[]

  @@index([isActive])
}

